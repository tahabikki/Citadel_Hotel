{
  "name": "citadel-hotel",
  "private": true,
  "version": "1.0.0",
  "description": "Citadel Hotel PMS - Full Stack",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend/citadel-hotel && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "cd frontend/citadel-hotel && npm run build",
    "build:backend": "cd backend && npm run build",
    "start": "npm run start:backend",
    "start:frontend": "cd frontend/citadel-hotel && npm run start",
    "start:backend": "cd backend && npm run start",
    "db:push": "cd backend && npx prisma db push",
    "db:generate": "cd backend && npx prisma generate",
    "db:studio": "cd backend && npx prisma studio",
    "install:all": "npm install && cd frontend/citadel-hotel && npm install && cd ../../backend && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}